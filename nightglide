#!/usr/bin/env sh
# Nightglide launcher: runs the vendored OMP fork source CLI.
#
# Mirrors upstream's scripts/omp dev launcher: Bun reads bunfig.toml from the
# *current* directory at startup (foreign preloads would execute inside
# Nightglide), and `bun --cwd` would leave the vendored source directory as
# the process cwd — making getProjectDir() resolve sessions and project files
# to vendor/omp instead of the user's working directory. So: remember the
# real cwd in OMP_LAUNCH_CWD, cd to a bunfig-free directory, and let the
# upstream preload shim (scripts/omp.ts) restore the cwd before imports run.
set -e

# Resolve symlinks of $0 so invoking through a link (e.g. ~/bin/nightglide)
# still finds this repository; same approach as scripts/install.sh.
LAUNCHER_PATH="$0"
while [ -L "$LAUNCHER_PATH" ]; do
	LINK="$(readlink "$LAUNCHER_PATH")"
	case "$LINK" in
		/*) LAUNCHER_PATH="$LINK" ;;
		*) LAUNCHER_PATH="$(dirname -- "$LAUNCHER_PATH")/$LINK" ;;
	esac
done
DIR="$(CDPATH= cd -- "$(dirname -- "$LAUNCHER_PATH")" && pwd -P)"
FORK_CLI="$DIR/vendor/omp/packages/coding-agent/src/cli.ts"
FORK_PRELOAD="$DIR/vendor/omp/packages/coding-agent/scripts/omp.ts"

[ -f "$FORK_CLI" ] || { echo "nightglide: $FORK_CLI not found; run 'git submodule update --init --recursive' and 'bun install' first." >&2; exit 1; }

# Bun's fetch honors HTTP(S)_PROXY / ALL_PROXY. With an empty NO_PROXY, local
# model servers (oMLX, Ollama, LM Studio on 127.0.0.1) are sent through that
# proxy, which typically cannot reach the user's loopback: discovery times out
# and requests hang on "Working…". Always exempt loopback, keeping any entries
# the user already set.
for host in 127.0.0.1 localhost ::1; do
	case ",${NO_PROXY:-}," in *",$host,"*) ;; *) NO_PROXY="${NO_PROXY:+$NO_PROXY,}$host" ;; esac
	case ",${no_proxy:-}," in *",$host,"*) ;; *) no_proxy="${no_proxy:+$no_proxy,}$host" ;; esac
done
export NO_PROXY no_proxy

export PI_RAW_BIN="nightglide"
export OMP_APP_NAME="nightglide"

LAUNCH_DIR="${OMP_DEV_LAUNCH_DIR:-${HOME}/.omp/.dev-cwd}"
[ -d "$LAUNCH_DIR" ] || mkdir -p "$LAUNCH_DIR"

OMP_LAUNCH_CWD=$PWD
export OMP_LAUNCH_CWD
cd "$LAUNCH_DIR"
exec bun --preload "$FORK_PRELOAD" "$FORK_CLI" "$@"
