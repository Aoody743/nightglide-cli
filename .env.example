# Nightglide Environment Configuration Template
# Copy relevant lines to .env (or your shell profile) if you need overrides.
# Do NOT commit .env or secrets to version control.
#
# Nightglide runs on the vendored OMP source (`bun run ng` / `bun run omp`).
# Provider credentials (API keys) live in OMP's own auth storage / models.yml
# (~/.omp/agent/), managed by OMP itself — Nightglide does not read or store
# keys through this file.

# Local oMLX endpoint override (default: http://127.0.0.1:8000/v1).
# Setting this forces the oMLX provider to be discovered at that URL.
#OMLX_BASE_URL=http://127.0.0.1:8000/v1

# Binary name used in the CLI banner and help output (default: nightglide).
#PI_RAW_BIN=nightglide

# Application label for usage attribution / notifications (default: omp).
#OMP_APP_NAME=nightglide

# Disable colored output entirely (honored by the terminal stack).
#NO_COLOR=1

# Cloud providers: configure through the OMP settings UI or ~/.omp/agent/models.yml.
# Nightglide never writes API keys here; see docs/SECURITY.md and docs/OMP_BASELINE.md.
