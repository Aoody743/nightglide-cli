# Nightglide Environment Configuration Template
# Copy this file to .env and fill in your values if using cloud or authenticated endpoints.
# Do NOT commit .env or secrets to version control.

# Local Provider Endpoint (e.g. oMLX, Ollama, vLLM, LM Studio)
NIGHTGLIDE_LOCAL_API_BASE=http://127.0.0.1:8000/v1
NIGHTGLIDE_LOCAL_API_KEY=

# Cloud Providers (Optional - explicit user configuration required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Nightglide Runtime Overrides
NIGHTGLIDE_LOG_LEVEL=info
NIGHTGLIDE_THEME=midnight-flight
NIGHTGLIDE_MODE=guided
